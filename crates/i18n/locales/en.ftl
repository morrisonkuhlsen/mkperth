col-late-finish = Late finish
col-total-float = Total float
col-free-float = Free float
btn-open = Open…
btn-sample = Sample
btn-schedule = Schedule
status-opened = Opened { $name }
status-scheduled = Scheduled
status-summary = { $activities } activities · finishes { $finish } · { $critical } critical
status-ignored = { $n } relationships to summaries left out
status-not-scheduled = Not scheduled
status-warnings = { $n } warnings on opening
month-1 = Jan
month-2 = Feb
month-3 = Mar
month-4 = Apr
month-5 = May
month-6 = Jun
month-7 = Jul
month-8 = Aug
month-9 = Sep
month-10 = Oct
