# MK Perth's messages in English. Command ids and file formats are never translated.

err-calendar-no-working-days = The calendar { $name } has no working day to place an activity on.
err-calendar-out-of-range = The calendar { $name } ran past the last date it can count.
err-duplicate-activity = Two activities have the ID { $id }; each ID must be unique.
err-unknown-activity = A relationship names the activity { $id }, which isn't in the project.
err-self-relationship = The activity { $id } is related to itself.
err-negative-duration = The activity { $id } has a negative duration.
err-loop = These relationships go round in a loop, so no order satisfies them: { $ids }
err-too-many = The project has more { $what } than the { $max } MK Perth schedules.
err-too-long = The schedule runs past { $max } working days, the longest MK Perth places.
what-activities = activities
what-relationships = relationships
