# MK Perth's messages in English. Command ids and file formats are never translated.

err-calendar-no-working-days = The calendar { $name } has no working day to place an activity on.
err-calendar-out-of-range = The calendar { $name } ran past the last date it can count.
err-duplicate-activity = Two activities have the ID { $id }; each ID must be unique.
err-unknown-activity = A relationship names the activity { $id }, which isn't in the project.
err-self-relationship = The activity { $id } is related to itself.
err-negative-duration = The activity { $id } has a negative duration.
err-unknown-calendar = The activity { $id } works on the calendar { $name }, which the project doesn't have.
err-unknown-parent = The activity { $id } sits under { $parent }, which isn't in the project.
err-parent-loop = These activities sit under one another in a loop: { $ids }
err-milestone-parent = The milestone { $id } has activities under it; a milestone can't be a summary.
err-loop = These relationships go round in a loop, so no order satisfies them: { $ids }
err-too-many = The project has more { $what } than the { $max } MK Perth schedules.
err-too-long = The schedule runs past { $max } working days, the longest MK Perth places.
what-activities = activities
what-relationships = relationships

err-perth-json = This isn't JSON Perth wrote: { $detail }
err-perth-not-a-project = This JSON isn't a Perth project: it has no list of tasks.
err-perth-field = Task { $task }: the field { $field } isn't what Perth writes there.
err-perth-too-many = The file holds more than MK Perth reads (at most { $max } tasks, and as many dependencies per task).
warn-perth-duration = Task { $task } had a duration under a day; Perth counts it as one.
warn-perth-dangling = Task { $task } depends on { $dependency }, which isn't in the project; left out, as Perth does.
warn-perth-constraint = Task { $task } has a constraint Perth has no field for; it isn't written.
warn-perth-sf = Task { $task } follows { $predecessor } start-to-finish, which Perth doesn't have; that relationship isn't written.
warn-perth-calendar = The calendar { $name } isn't one MK Perth knows the holidays of: Monday to Friday, with no holidays.
err-unknown-command = There is no command { $id }.
err-command-param = The command { $command } needs the parameter { $param }.
err-file = { $path }: { $detail }

